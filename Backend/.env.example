# OpenAI — used for the vision grading pipeline (reads handwriting + printed text,
# returns bounding boxes for highlighting)
OPENAI_API_KEY=sk-your-key-here
OPENAI_VISION_MODEL=gpt-4o
# Cheaper model used for low-risk / low-stakes sub-calls to keep cost down
OPENAI_FAST_MODEL=gpt-4o-mini

PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Optional: geometry-only line-detection sidecar (OcrService/), used to place
# precise answer highlight boxes. The pipeline works without it, just with no boxes.
OCR_SERVICE_URL=http://localhost:8000
# Winston AI key for the AI content-detection report (https://dev.gowinston.ai)
WISTON_AI=your-winston-ai-key-here